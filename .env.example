# Copie este arquivo para .env e ajuste os valores.

# Banco de dados (usado pelo container do Postgres e pela URL de conexão do Flask)
POSTGRES_USER=sensor
POSTGRES_PASSWORD=sensor123
POSTGRES_DB=sensoriamento

# Chave que o microcontrolador envia no header X-API-Key.
# Use o mesmo valor no #define API_KEY do sketch.
API_KEY=troque-esta-chave
